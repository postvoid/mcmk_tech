# База данных
POSTGRES_ENGINE=postgresql+asyncpg://user:pass@localhost:5432/db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_password
POSTGRES_DB=mcmk_notifications

# Bitrix24 интеграция
